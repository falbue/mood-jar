{
	"bot":{
		"name":"Баночка настроения",
		"short_description":"На свой страх и риск",
		"description":"Бот на стадии альфа теста\n\nПо всем вопросам @falbue"
	},

	"menu":{
		"none_menu":{
			"loading":true,
			"text":"Меню `{menu_name}` не найдено",
			"return":"main"
		},

		"main":{
			"row":8,
			"text":"Выберите Ваше текущее настроение",
			"keyboard":"moods"
		},

		"mood|{mood}|{topic}":{
			"row":3,
			"text":"Введите причину настроения __{mood}__\n\n*Топики:* {select_topics}\n\nТак же можно выбрать *топики*",
			"function":"select_topic",
			"input":{
                "data":"in_mood",
                "menu":"mood|{mood}|{topic}",
                "function":"multi_generator"
            },
			"keyboard":{
				"function":"topics",
				"return|main":"\\‹ Назад",
				"main|":"Добавить"
			}
		}
		
	},


	"variables":{
		"tta_return":"‹ Назад",
		"tta_loading":"Загрузка..."
	},


	"commands":{
		"start":{
			"description":"🔄 Перезапуск бота",
			"menu":"main"
		}
	}
}